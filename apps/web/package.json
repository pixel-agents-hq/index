{
  "name": "@pixel-index/web",
  "version": "0.0.0",
  "private": true,
  "description": "Static gallery SPA — GitHub Pages in production, Vercel for PR previews",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "lint": "eslint .",
    "preview": "vite preview --configLoader runner",
    "test": "vitest run",
    "test:e2e": "node e2e/live-preview.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@material-symbols/font-700": "^0.46.0",
    "@pixel-index/layout-core": "*",
    "@pixel-index/pixatar": "*",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^25.0.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.10"
  }
}
