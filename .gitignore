# Build output. Previews and the index are generated on every build and
# published with the site, never committed, so they cannot drift from the
# layouts or from the pinned Pixel Agents.
dist/

node_modules/

# Browser-test diagnostics (screenshots are printed on failure, never committed).
test-results/

# Scratch markdown written and removed by tools/check-mermaid.test.mjs. Ignored
# so a crashed run cannot leave a deliberately-broken diagram somewhere the
# mermaid check would then pick up.
.mermaid-fixtures/

# Local deployment config
.env
.env.local
.env.*.local

# The pinned vendor wardrobe, baked by packages/pixatar/scripts/generate-wardrobe.mjs
# before every build, test and typecheck. Never committed, so it cannot drift
# from the pin.
packages/pixatar/src/generated/

# The Python avatar client (packages/pixatar/python).
__pycache__/
*.egg-info/
.pytest_cache/
packages/pixatar/python/build/
