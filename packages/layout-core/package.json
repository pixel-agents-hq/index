{
  "name": "@pixel-index/layout-core",
  "version": "0.0.0",
  "private": true,
  "description": "Shared layout validation, stats and schemas, checked against the pinned Pixel Agents",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/layout": "./schema/layout.schema.json",
    "./schema/meta": "./schema/meta.schema.json",
    "./schema/custom-asset-furniture-manifest": "./schema/custom-asset-furniture-manifest.schema.json",
    "./schema/custom-asset-pet-manifest": "./schema/custom-asset-pet-manifest.schema.json"
  },
  "bin": {
    "pixel-index-validate": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
